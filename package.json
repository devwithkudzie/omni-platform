{
  "name": "omnicontact-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "php -S 127.0.0.1:8080 -t backend/public",
    "dev:docker": "docker compose up --build",
    "build": "npm run build --workspace frontend",
    "deploy": "npm run deploy:zip",
    "deploy:zip": "node scripts/build-cpanel-public-html.mjs",
    "lint": "npm run lint --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "react-fast-marquee": "^1.6.5"
  }
}
